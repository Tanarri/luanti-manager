#!/bin/bash
set -euo pipefail

VERSION="1.0.0"

# Paths can be overridden by the caller or the systemd unit.
LUANTI_DIR="${LUANTI_DIR:-$HOME/luanti}"
BASE_DIR="${BASE_DIR:-$HOME/luanti-manager}"
CONF_FILE="${CONF_FILE:-$BASE_DIR/luanti_instances.conf}"
RUN_DIR="$BASE_DIR/run"

# General helpers
die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN:  $*" >&2; }

usage() {
  cat <<'EOF'
luantictl - Luanti Multi-Instance Controller

Usage:
  luantictl start   all|<name>
  luantictl stop    all|<name>
  luantictl restart all|<name>
  luantictl run     <name>
  luantictl status  [all|<name>]
  luantictl tail    <name> [lines]
  luantictl ports
  luantictl check
  luantictl version
  luantictl help

run starts Luanti in the foreground for systemd.
start/restart/stop use an installed systemd unit, or PID files otherwise.
tail reads only the log file of a directly started server.
UDP port inspection requires ss.

Optional environment variables:
  LUANTI_DIR=/path/to/luanti
  BASE_DIR=/path/to/luanti-manager
  CONF_FILE=/path/to/luanti_instances.conf

Configuration format:
  NAME|WORLDREL|PORT|LOGREL|GAMEID
  NAME may contain letters, digits, _, . and - only.
  GAMEID may be empty.
EOF
}

need_conf() {
  [[ -f "$CONF_FILE" ]] || die "Configuration file not found: $CONF_FILE"
}

need_luanti() {
  [[ -d "$LUANTI_DIR" ]] || die "LUANTI_DIR not found: $LUANTI_DIR"
  [[ -x "$LUANTI_DIR/bin/luanti" ]] || die "Luanti binary is not executable: $LUANTI_DIR/bin/luanti"
}

# Configuration parsing
trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

parse_instance_line() {
  # Sets NAME, WORLDREL, PORT, LOGREL and GAMEID for the caller.
  IFS='|' read -r NAME WORLDREL PORT LOGREL GAMEID <<< "$1"
  NAME="$(trim "$NAME")"
  WORLDREL="$(trim "$WORLDREL")"
  PORT="$(trim "$PORT")"
  LOGREL="$(trim "$LOGREL")"
  GAMEID="$(trim "$GAMEID")"
  [[ -n "$NAME" && "$NAME" != \#* ]]
}

# Passes each configuration row to the callback as five arguments.
# Aggregate mode checks every row and reports failure after the complete file.
for_each_instance() {
  local cb="$1" line=""
  local aggregate_errors="${2:-false}" failed=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    parse_instance_line "$line" || continue
    if [[ "$aggregate_errors" == true ]]; then
      "$cb" "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID" || failed=1
    else
      "$cb" "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
    fi
  done < "$CONF_FILE"
  return "$failed"
}

get_instance_line() {
  local target="$1" line=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    parse_instance_line "$line" || continue
    if [[ "$NAME" == "$target" ]]; then
      printf '%s|%s|%s|%s|%s\n' "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
      return 0
    fi
  done < "$CONF_FILE"
  return 1
}

valid_instance_name() { [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]]; }
pidfile_of() {
  valid_instance_name "$1" || die "Invalid instance name: $1"
  echo "$RUN_DIR/$1.pid"
}
logfile_of_rel() { echo "$BASE_DIR/$1"; }

# Direct process identity
#
# A PID alone is unsafe because Linux can reuse it. PID files therefore store
# "PID START_TIME BOOT_ID" and every signal path verifies all three values.
is_pid_running() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null
}

pid_start_time() {
  local pid="$1" stat
  local -a fields
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  IFS= read -r stat 2>/dev/null < "/proc/$pid/stat" || return 1
  # After the parenthesized process name, index 19 is starttime (field 22).
  read -r -a fields <<< "${stat##*) }"
  [[ ${#fields[@]} -ge 20 ]] || return 1
  [[ "${fields[0]}" != Z && "${fields[0]}" != X ]] || return 3
  printf '%s\n' "${fields[19]}"
}

boot_id() {
  local id
  IFS= read -r id < /proc/sys/kernel/random/boot_id || return 1
  printf '%s\n' "$id"
}

# Return: 0 = verified process, 1 = exited/stale, 2 = live PID with mismatched identity.
pidfile_state() {
  local pidfile="$1" pid start boot extra current_start current_boot stat_status
  MANAGED_PID=""
  [[ -f "$pidfile" ]] || return 1
  read -r pid start boot extra < "$pidfile" || return 1
  is_pid_running "$pid" || return 1
  [[ "$start" =~ ^[0-9]+$ && -z "${extra:-}" ]] || return 2
  current_boot="$(boot_id)" || return 2
  [[ "$boot" == "$current_boot" ]] || return 2
  if current_start="$(pid_start_time "$pid")"; then
    :
  else
    stat_status=$?
    if (( stat_status == 3 )) || ! is_pid_running "$pid"; then return 1; fi
    return 2
  fi
  [[ "$start" == "$current_start" ]] || return 2
  MANAGED_PID="$pid"
  return 0
}

# systemd integration
#
# Both scopes are recognized to support migration from the former system unit.
# User units take precedence when both variants are installed.
systemctl_in_scope() {
  local scope="$1"
  shift
  if [[ "$scope" == user ]]; then
    systemctl --user "$@"
  else
    systemctl "$@"
  fi
}

service_scope() {
  local wanted="$1" unit="luanti@$2.service" scope state
  command -v systemctl >/dev/null 2>&1 || return 1
  # Prefer a user unit when a legacy system unit is installed as well.
  for scope in user system; do
    if [[ "$wanted" == active ]]; then
      if systemctl_in_scope "$scope" is-active --quiet "$unit" 2>/dev/null; then
        echo "$scope"
        return 0
      fi
    else
      state="$(systemctl_in_scope "$scope" show -p LoadState --value "$unit" 2>/dev/null)" || continue
      if [[ "$state" == loaded ]]; then
        echo "$scope"
        return 0
      fi
    fi
  done
  return 1
}

service_action() {
  systemctl_in_scope "$1" "$2" "luanti@$3.service"
}

service_main_pid() {
  systemctl_in_scope "$1" show -p MainPID --value "luanti@$2.service"
}

# UDP port inspection
port_listening() {
  local port="$1"
  local sockets
  # Luanti uses UDP. Return 2 when the port cannot be inspected.
  command -v ss >/dev/null 2>&1 || return 2
  sockets="$(ss -H -lun)" || return 2
  awk -v port="$port" '
    {
      local_address = $4
      sub(/^.*:/, "", local_address)
      if (local_address == port) found = 1
    }
    END { exit !found }
  ' <<< "$sockets"
}

require_free_port() {
  local name="$1" port="$2" result
  if port_listening "$port"; then
    warn "[$name] UDP port $port is already in use. Aborting."
    return 2
  else
    result=$?
    if (( result != 1 )); then
      warn "[$name] UDP port $port could not be inspected. Aborting."
      return 2
    fi
  fi
  return 0
}

port_state() {
  local result
  if port_listening "$1"; then
    echo yes
  else
    result=$?
    if (( result == 1 )); then echo no; else echo '?'; fi
  fi
}

# Instance lifecycle
start_one() {
  local NAME="$1" WORLDREL="$2" PORT="$3" LOGREL="$4" GAMEID="$5"
  local PIDFILE LOGFILE PID exit_status pid_state start_time current_boot scope
  PIDFILE="$(pidfile_of "$NAME")"
  LOGFILE="$(logfile_of_rel "$LOGREL")"

  if scope="$(service_scope active "$NAME")"; then
    echo "[$NAME] already running as a systemd $scope service"
    return 0
  fi

  # Do not start a second copy of a verified direct instance.
  if [[ -f "$PIDFILE" ]]; then
    if pidfile_state "$PIDFILE"; then
      echo "[$NAME] already running (PID $MANAGED_PID)"
      return 0
    else
      pid_state=$?
      if (( pid_state == 2 )); then
        warn "[$NAME] PID file cannot be verified: $PIDFILE. Aborting."
        return 2
      fi
      rm -f "$PIDFILE"
    fi
  fi

  require_free_port "$NAME" "$PORT" || return $?

  if scope="$(service_scope loaded "$NAME")"; then
    echo "[$NAME] start: systemd $scope service"
    service_action "$scope" start "$NAME"
    return
  fi

  mkdir -p "$RUN_DIR" "$(dirname "$LOGFILE")"
  cd "$LUANTI_DIR" || return 1

  local CMD=(./bin/luanti --world "$WORLDREL" --server --port "$PORT")
  if [[ -n "${GAMEID:-}" ]]; then
    CMD+=(--gameid "$GAMEID")
  fi

  current_boot="$(boot_id)" || die "Boot ID cannot be read"
  echo "[$NAME] start: world=$WORLDREL port=$PORT gameid=${GAMEID:-<default>} log=$LOGFILE"
  nohup "${CMD[@]}" >>"$LOGFILE" 2>&1 &
  PID=$!
  if ! start_time="$(pid_start_time "$PID")"; then
    exit_status=0
    wait "$PID" || exit_status=$?
    warn "[$NAME] Start failed (exit code $exit_status). Details: $LOGFILE"
    return 1
  fi
  printf '%s %s %s\n' "$PID" "$start_time" "$current_boot" > "$PIDFILE"

  # Catch immediate startup failures before reporting success.
  sleep 1
  if ! is_pid_running "$PID"; then
    exit_status=0
    wait "$PID" || exit_status=$?
    rm -f "$PIDFILE"
    warn "[$NAME] Start failed (exit code $exit_status). Details: $LOGFILE"
    return 1
  fi

  echo "[$NAME] process is running (PID $PID)"
}

run_one() {
  local NAME="$1" WORLDREL="$2" PORT="$3" LOGREL="$4" GAMEID="$5"

  require_free_port "$NAME" "$PORT" || return $?

  cd "$LUANTI_DIR" || return 1

  local CMD=(./bin/luanti --world "$WORLDREL" --server --port "$PORT")
  if [[ -n "${GAMEID:-}" ]]; then
    CMD+=(--gameid "$GAMEID")
  fi

  echo "[$NAME] run: world=$WORLDREL port=$PORT gameid=${GAMEID:-<default>}"

  # systemd tracks the server process directly, so no PID file is used here.
  exec "${CMD[@]}"
}

# Return: 0 = exited, 1 = still running, 2 = process identity no longer matches.
wait_for_managed_exit() {
  local pidfile="$1" attempts="$2" delay="$3" state i
  for ((i = 0; i < attempts; i++)); do
    if pidfile_state "$pidfile"; then
      sleep "$delay"
    else
      state=$?
      if (( state == 1 )); then return 0; else return 2; fi
    fi
  done
  if pidfile_state "$pidfile"; then
    return 1
  else
    state=$?
    if (( state == 1 )); then return 0; else return 2; fi
  fi
}

stop_one() {
  local NAME="$1"
  local PIDFILE PID pid_state scope
  PIDFILE="$(pidfile_of "$NAME")"

  if scope="$(service_scope active "$NAME")"; then
    echo "[$NAME] stop: systemd $scope service"
    service_action "$scope" stop "$NAME" || return $?
  fi

  if [[ ! -f "$PIDFILE" ]]; then
    if [[ -z "${scope:-}" ]]; then
      echo "[$NAME] no PID file (not started directly?)"
    fi
    return 0
  fi

  if pidfile_state "$PIDFILE"; then
    PID="$MANAGED_PID"
  else
    pid_state=$?
    if (( pid_state == 2 )); then
      warn "[$NAME] PID file cannot be verified: $PIDFILE. Process will not be stopped."
      return 2
    fi
    echo "[$NAME] process is not running; removing stale PID file"
    rm -f "$PIDFILE"
    return 0
  fi

  echo "[$NAME] stop: PID $PID"
  kill "$PID" 2>/dev/null || true

  if wait_for_managed_exit "$PIDFILE" 20 0.5; then
    rm -f "$PIDFILE"
    echo "[$NAME] stopped"
    return 0
  else
    pid_state=$?
    if (( pid_state == 2 )); then
      warn "[$NAME] Process identity changed. No further signal will be sent."
      return 2
    fi
  fi

  # Verify again before SIGKILL because the PID may have been reused.
  if pidfile_state "$PIDFILE"; then
    :
  else
    pid_state=$?
    if (( pid_state == 1 )); then
      rm -f "$PIDFILE"
      echo "[$NAME] stopped"
      return 0
    fi
    warn "[$NAME] Process identity changed. SIGKILL will not be sent."
    return 2
  fi
  echo "[$NAME] stop: SIGKILL PID $PID"
  kill -9 "$PID" 2>/dev/null || { warn "[$NAME] SIGKILL failed"; return 1; }
  if wait_for_managed_exit "$PIDFILE" 20 0.1; then
    rm -f "$PIDFILE"
    echo "[$NAME] stopped (hard)"
    return 0
  else
    pid_state=$?
    if (( pid_state == 2 )); then
      warn "[$NAME] Process identity changed. PID file was retained."
      return 2
    fi
  fi
  warn "[$NAME] Process is still running after SIGKILL (PID $PID)"
  return 1
}

status_one() {
  local NAME="$1" WORLDREL="$2" PORT="$3" LOGREL="$4" GAMEID="$5"
  local PIDFILE PID alive="no" pid_state scope

  PIDFILE="$(pidfile_of "$NAME")"

  # Check a directly started instance before querying systemd.
  if [[ -f "$PIDFILE" ]]; then
    if pidfile_state "$PIDFILE"; then
      PID="$MANAGED_PID"
      alive="yes"
    else
      pid_state=$?
      if (( pid_state == 2 )); then alive="unknown"; fi
    fi
  fi

  if scope="$(service_scope active "$NAME")"; then
    alive="yes"
    PID="$(service_main_pid "$scope" "$NAME")"
  fi

  local listen
  listen="$(port_state "$PORT")"

  printf "[%s] pid=%s alive=%s listen=%s port=%s gameid=%s world=%s log=%s\n" \
    "$NAME" "${PID:-"-"}" "$alive" "$listen" "$PORT" "${GAMEID:-"-"}" "$WORLDREL" "$LOGREL"
}

check_conf() {
  for_each_instance _check_line true
}

# Configuration callbacks
_check_line() {
  local NAME="$1" WORLDREL="$2" PORT="$3" LOGREL="$4" GAMEID="$5"

  [[ -n "$NAME" ]] || { warn "Empty NAME"; return 1; }
  valid_instance_name "$NAME" || { warn "Invalid NAME: $NAME"; return 1; }
  [[ -n "$WORLDREL" ]] || { warn "[$NAME] WORLDREL is empty"; return 1; }
  [[ -n "$PORT" ]] || { warn "[$NAME] PORT is empty"; return 1; }
  [[ "$PORT" =~ ^[0-9]+$ ]] || { warn "[$NAME] PORT is not a number: $PORT"; return 1; }
  if (( ${#PORT} > 5 )) || (( 10#$PORT < 1 || 10#$PORT > 65535 )); then
    warn "[$NAME] PORT is outside 1..65535: $PORT"
    return 1
  fi
  [[ -n "$LOGREL" ]] || { warn "[$NAME] LOGREL is empty"; return 1; }

  # A missing world makes the configuration invalid.
  if [[ ! -d "$LUANTI_DIR/$WORLDREL" ]]; then
    warn "[$NAME] World path does not exist: $LUANTI_DIR/$WORLDREL"
    return 1
  fi

  return 0
}

_restart_one() {
  local NAME="$1" WORLDREL="$2" PORT="$3" LOGREL="$4" GAMEID="$5"
  local scope
  if scope="$(service_scope active "$NAME")"; then
    echo "[$NAME] restart: systemd $scope service"
    service_action "$scope" restart "$NAME"
    return
  fi
  if scope="$(service_scope loaded "$NAME")"; then
    if [[ -f "$(pidfile_of "$NAME")" ]]; then stop_one "$NAME"; fi
    echo "[$NAME] restart: systemd $scope service"
    start_one "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
    return
  fi
  stop_one "$NAME"
  sleep 1
  start_one "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
}

_ports_one() {
  local NAME="$1" _WORLDREL="$2" PORT="$3" _LOGREL="$4" _GAMEID="$5"
  local listen
  listen="$(port_state "$PORT")"
  case "$listen" in
    yes) listen="LISTEN" ;;
    no) listen="-" ;;
  esac
  printf "[%s] port=%s %s\n" "$NAME" "$PORT" "$listen"
}

# Command dispatch
cmd="${1:-help}"
arg="${2:-}"

case "$cmd" in
  help|--help|-h|version|--version|-V) ;;
  start|restart|run|check) need_conf; need_luanti ;;
  *) need_conf ;;
esac

case "$cmd" in
  help|--help|-h)
    usage
    ;;

  version|--version|-V)
    echo "luantictl $VERSION"
    ;;

  check)
    if check_conf; then
      echo "OK: Configuration is valid."
    else
      echo "Configuration has errors (see WARN/ERROR messages)."
      exit 2
    fi
    ;;

  start)
    [[ -n "$arg" ]] || die "start requires all|<name>"
    if [[ "$arg" == "all" ]]; then
      for_each_instance start_one
    else
      line="$(get_instance_line "$arg")" || die "Unknown instance: $arg"
      IFS='|' read -r NAME WORLDREL PORT LOGREL GAMEID <<<"$line"
      start_one "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
    fi
    ;;

  stop)
    [[ -n "$arg" ]] || die "stop requires all|<name>"
    if [[ "$arg" == "all" ]]; then
      for_each_instance stop_one
    else
      stop_one "$arg"
    fi
    ;;

  restart)
    [[ -n "$arg" ]] || die "restart requires all|<name>"
    if [[ "$arg" == "all" ]]; then
      for_each_instance _restart_one
    else
      line="$(get_instance_line "$arg")" || die "Unknown instance: $arg"
      IFS='|' read -r NAME WORLDREL PORT LOGREL GAMEID <<<"$line"
      _restart_one "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
    fi
    ;;

  run)
    [[ -n "$arg" ]] || die "run requires <name>"
    line="$(get_instance_line "$arg")" || die "Unknown instance: $arg"
    IFS='|' read -r NAME WORLDREL PORT LOGREL GAMEID <<<"$line"
    run_one "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
    ;;

  status)
    if [[ -z "$arg" || "$arg" == "all" ]]; then
      for_each_instance status_one
    else
      line="$(get_instance_line "$arg")" || die "Unknown instance: $arg"
      IFS='|' read -r NAME WORLDREL PORT LOGREL GAMEID <<<"$line"
      status_one "$NAME" "$WORLDREL" "$PORT" "$LOGREL" "$GAMEID"
    fi
    ;;

  tail)
    [[ -n "$arg" ]] || die "tail requires <name> [lines]"
    lines="${3:-100}"
    line="$(get_instance_line "$arg")" || die "Unknown instance: $arg"
    IFS='|' read -r NAME _WORLDREL _PORT LOGREL _GAMEID <<<"$line"
    LOGFILE="$(logfile_of_rel "$LOGREL")"
    [[ -f "$LOGFILE" ]] || die "Log file not found: $LOGFILE"
    tail -n "$lines" -f "$LOGFILE"
    ;;

  ports)
    for_each_instance _ports_one
    ;;

  *)
    die "Unknown command: $cmd (use: luantictl help)"
    ;;
esac
